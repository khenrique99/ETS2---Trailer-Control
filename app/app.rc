// Recursos do app Trailer Control
#include <winres.h>

1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,3,0,0
 PRODUCTVERSION 0,3,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041604b0"
        BEGIN
            VALUE "FileDescription", "Trailer Control - painel de engate para ETS2"
            VALUE "FileVersion", "0.3.0"
            VALUE "ProductName", "ETS2 Trailer Control"
            VALUE "ProductVersion", "0.3.0"
            VALUE "OriginalFilename", "TrailerControl.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x416, 1200
    END
END
